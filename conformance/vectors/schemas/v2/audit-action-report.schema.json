{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "v2/audit-action-report.schema.json",
  "title": "AI Action Report (GET /audit/action-report data) — v2",
  "description": "AI Action Report compliance report data (ActionReport). v2 splits a denied tool call into the two gates that can deny it: `blocked` (the risk policy, which never reached a decision) and `refused` (the governance / authorization gate). `refused` is added to both `summary` and every `byDay` bucket, so the two halves of one response classify the same row the same way. Source: governance-shared/services/audit-evidence.service.ts getActionReport + by-day.ts. / AI Action Report 合规证据包响应 data。v2 把被拒的工具调用拆成两道闸：`blocked`（风险策略，**没有到过裁决**）与 `refused`（治理 / 授权闸）。`refused` 同时进 `summary` 与每个 `byDay` 桶，于是同一份响应的两半对同一行分类一致。",
  "type": "object",
  "required": ["period", "summary", "byAction", "byDay", "hashChain", "samples", "effectDiffs"],
  "additionalProperties": false,
  "properties": {
    "period": {
      "type": "object",
      "required": ["since", "to"],
      "additionalProperties": false,
      "properties": { "since": { "type": ["string", "null"] }, "to": { "type": "string" } }
    },
    "summary": {
      "type": "object",
      "required": ["executed", "approved", "rejected", "blocked", "refused", "errors", "effects"],
      "additionalProperties": false,
      "properties": {
        "executed": { "type": "number" },
        "approved": { "type": "number" },
        "rejected": { "type": "number" },
        "blocked": { "type": "number" },
        "refused": { "type": "number" },
        "errors": { "type": "number" },
        "effects": { "type": "number" }
      }
    },
    "byAction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "count"],
        "additionalProperties": false,
        "properties": { "action": { "type": "string" }, "count": { "type": "number" } }
      }
    },
    "byDay": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "executed", "approved", "rejected", "blocked", "refused", "errors"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "executed": { "type": "number" },
          "approved": { "type": "number" },
          "rejected": { "type": "number" },
          "blocked": { "type": "number" },
          "refused": { "type": "number" },
          "errors": { "type": "number" }
        }
      }
    },
    "hashChain": {
      "type": "object",
      "required": ["valid", "checked", "brokenIndex", "tableRows"],
      "additionalProperties": false,
      "properties": {
        "valid": { "type": "boolean" },
        "checked": { "type": "number" },
        "brokenIndex": { "type": ["number", "null"] },
        "tableRows": { "type": "number" }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "isError", "createdAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "number" },
          "action": { "type": "string" },
          "toolName": { "type": ["string", "null"] },
          "isError": { "type": "boolean" },
          "errorMessage": { "type": ["string", "null"] },
          "businessEvent": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] },
          "agentId": { "type": ["string", "null"] },
          "createdAt": { "type": "string" }
        }
      }
    },
    "effectDiffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "toolName", "resultType", "resultId", "createdAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "number" },
          "toolName": { "type": "string" },
          "resultType": { "type": "string" },
          "resultId": { "type": ["number", "string"] },
          "createdAt": { "type": "string" },
          "before": { "description": "parseSnapshot(beforeSnapshot)——对象/标量/null 皆可" },
          "after": { "description": "parseSnapshot(afterSnapshot)——对象/标量/null 皆可" }
        }
      }
    }
  }
}
