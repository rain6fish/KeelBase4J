{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "v3/audit-chain-verification.schema.json",
  "title": "Audit Chain Verification (GET /audit/verify data) — v3",
  "description": "Audit hash-chain verification response data. v3 publishes membership, not only counts: `tableIds` and `verifiedIds` fingerprint the two populations, and `unverifiedIds` names the difference down to capped row ids. A count pair computed from one table can agree while a reader still cannot reach every row; a fingerprint can be recomputed from what the reader enumerates, so the comparison is no longer free. Digest formula: sha256(ids sorted ascending, joined by \",\"), first 16 hex. Source: governance-shared/services/audit-evidence.service.ts verifyChain + id-set.ts. / 审计哈希链校验响应 data。v3 公布成员性而不只是计数：`tableIds` 与 `verifiedIds` 给两个人口取指纹，`unverifiedIds` 把差额点名到 id（封顶）。同一张表上算出的两个计数可以一致，而读者仍然够不到每一行；指纹可以由读者从自己枚举到的结果重算，故这个比对不再是免费的。摘要算法：sha256(升序 id 以 \",\" 连接) 取前 16 位十六进制。",
  "type": "object",
  "required": ["valid", "checked", "tableRows", "tableIds", "verifiedIds", "unverifiedIds", "chain"],
  "additionalProperties": false,
  "definitions": {
    "idSet": {
      "type": "object",
      "required": ["min", "max", "count", "digest"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "count": { "type": "number" },
        "digest": { "type": "string" }
      }
    },
    "idListing": {
      "type": "object",
      "required": ["min", "max", "count", "digest", "ids", "truncated"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "count": { "type": "number" },
        "digest": { "type": "string" },
        "ids": { "type": "array", "items": { "type": "number" } },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "valid": { "type": "boolean" },
    "checked": { "type": "number" },
    "tableRows": { "type": "number" },
    "brokenIndex": { "type": ["number", "null"] },
    "tableIds": { "$ref": "#/definitions/idSet" },
    "verifiedIds": { "$ref": "#/definitions/idSet" },
    "unverifiedIds": { "$ref": "#/definitions/idListing" },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "createdAt", "action", "isError"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "number" },
          "createdAt": { "type": "string" },
          "action": { "type": "string" },
          "toolName": { "type": ["string", "null"] },
          "prevHash": { "type": ["string", "null"] },
          "hash": { "type": ["string", "null"] },
          "isError": { "type": "boolean" },
          "broken": { "type": "boolean" }
        }
      }
    }
  }
}
