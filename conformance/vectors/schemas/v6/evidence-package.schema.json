  "definitions": {
    "signature": {
      "description": "证据包签名段（docs/evidence-root.spec.md §11）：null=未配密钥；字符串=HMAC-SHA256 hex（/1 /2 /3 历史包，向后兼容）；对象={hmac, sm2?}——HMAC 保留于 signature.hmac，SM2 为第三方持公钥可离线独立验签的非对称签名。签名对象（canonical）不因 SM2 改变：仍是整包剔除 signature 段自身。",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "$ref": "#/definitions/signatureObject"
        }
      ]
    },
    "signatureObject": {
      "type": "object",
      "required": [
        "hmac"
      ],
      "additionalProperties": false,
      "properties": {
        "hmac": {
          "description": "应用内对称验签（HMAC-SHA256）；未配 AUDIT_HMAC_KEY/ENCRYPTION_KEY 但配了 SM2 私钥时为 null。",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sm2": {
          "$ref": "#/definitions/sm2Signature"
        }
      }
    },
    "sm2Signature": {
      "description": "国密 SM2 签名（GB/T 32918.2-2016 / GM/T 0003.2-2012）：摘要固定 SM3，alg 恒为 SM2-with-SM3（不接受 SHA-256 替代）。value = SM2_Sign(privKey, canonical) 的 hex；userId 为实际使用的 Z 区分标识（须如实标注——openssl 默认空 ID ≠ 国标默认值，标错则第三方验签必失败）。",
      "type": "object",
      "required": [
        "alg",
        "encoding",
        "userId",
        "publicKey",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "SM2-with-SM3"
        },
        "encoding": {
          "description": "raw = r||s 各 32 字节（64 字节 → 128 hex，默认）；der = ASN.1 DER。",
          "enum": [
            "raw",
            "der"
          ]
        },
        "userId": {
          "description": "SM2 区分标识 Z 的取值（国标默认 1234567812345678，可配置；空串表示未设置 ID）。",
          "type": "string"
        },
        "publicKey": {
          "description": "验签公钥点：04||x||y 非压缩（65 字节 → 130 hex）或 02/03||x 压缩（33 字节 → 66 hex）。",
          "type": "string",
          "pattern": "^(04[0-9a-f]{128}|0[23][0-9a-f]{64})$"
        },
        "keyId": {
          "description": "可选：KMS/证书指纹，便于轮换与追溯。",
          "type": "string"
        },
        "certChain": {
          "description": "可选：企业 CA 证书链（PEM/Base64 X.509）。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "chainRow": {
      "type": "object",
      "required": [
        "seq",
        "id",
        "prevHash",
        "hash",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "integer"
        },
        "prevHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{64}|)$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "audit-payload.schema.json"
            },
            {
              "$ref": "operation-audit-payload.schema.json"
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "period",
        "summary",
        "hashChain",
        "byAction",
        "byDay",
        "samples",
        "effectDiffs"
      ],
      "additionalProperties": true,
      "properties": {
        "period": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        },
        "hashChain": {
          "type": "object",
          "required": [
            "valid"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "checked": {
              "type": "number"
            },
            "brokenIndex": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "byAction": {
          "type": "array"
        },
        "byDay": {
          "type": "array"
        },
        "samples": {
          "type": "array"
        },
        "effectDiffs": {
          "type": "array"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRevision",
        "scope",
        "sources",
        "verdict",
        "gaps"
      ],
      "properties": {
        "registryRevision": {
          "type": "string",
          "minLength": 1,
          "description": "产出本段所依据的缺口登记表版本（取其有序内容的前 12 hex，与 governance-policy.revision 同一写法）。没有它，一句 complete 无法对照当时适用的缺口读回来。"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "since",
            "to",
            "subjectRef"
          ],
          "properties": {
            "kind": {
              "enum": [
                "action",
                "period",
                "entity"
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            },
            "subjectRef": {
              "type": [
                "string",
                "null"
              ],
              "description": "kind = action / entity 时的对象引用（resultType:resultId）；period 为 null"
            }
          }
        },
        "sources": {
          "type": "array",
          "description": "**这份声明真的读了**的源 —— 是「问过谁」，不是「系统里有什么」。列一个谁也没查过的源，正是本段要打破的那种沉默。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state",
              "rows"
            ],
            "properties": {
              "id": {
                "enum": [
                  "ai_audit_chain",
                  "operation_audit_chain",
                  "side_effect_ledger",
                  "confirmation_records",
                  "governance_policy",
                  "conversation_records",
                  "host_operate_log"
                ]
              },
              "state": {
                "enum": [
                  "complete",
                  "partial",
                  "absent",
                  "unreachable"
                ]
              },
              "rows": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "verdict": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "description": "**算出来的，不是写上去的**：没有适用缺口 ⇒ complete；有一条缺口说「连漏了什么都说不出」⇒ unknown；其余 ⇒ partial。把 unknown 报成 partial 等于声称知道漏了什么，而那正是那条缺口说不知道的事。"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "affects",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "稳定、kebab-case、**永不复用**（复用会改变一份已发出的包的含义）。消费方按它取自己的词条；statement 是它的英文兜底。"
              },
              "severity": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "affects": {
                "enum": [
                  "this_package",
                  "whole_deployment"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "description": "该缺口的英文陈述（第三方离线可读）"
              }
            }
          }
        }
      }
    }
  }
}
