<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.com.keelbase</groupId>
    <artifactId>keelbase4j</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>keelbase4j-runtime</artifactId>
  <packaging>jar</packaging>

  <name>KeelBase4J Runtime</name>
  <description>
    The hand-written reference runtime: a Spring Boot application whose AI operations run only
    inside the trust boundary. This module is the deployment; adapters (a model provider, an
    identity provider) belong outside it and depend on it, never the other way round.
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.com.keelbase</groupId>
      <artifactId>keelbase4j-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Authentication lives at the request entry (ADR-0004 D3). The protocol library must stay free
      of this: see the protocol module's pom.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 split the test infrastructure per technology; TestRestTemplate comes from the
         Web MVC test starter, not from spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 moved RestTemplateBuilder into its own module; TestRestTemplate needs it, and the
         application itself never uses RestTemplate. Test scope, so it stays out of the runtime. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The conformance loader (Vectors) is shared with the protocol module's own tests, so the
         runtime reproduces the frozen vectors through exactly one implementation. Test scope:
         it is not part of what the runtime ships. -->
    <dependency>
      <groupId>cn.com.keelbase</groupId>
      <artifactId>keelbase4j-protocol</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- FailureSemanticsTest reads the frozen vector from the repository root. -->
          <systemPropertyVariables>
            <keelbase.vectors.dir>${project.basedir}/../conformance/vectors</keelbase.vectors.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Keep the plain jar as the main artifact so the runtime can also be used as a
               library, and publish the runnable boot jar separately with the `exec` classifier. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
