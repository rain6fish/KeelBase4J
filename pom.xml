<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>cn.com.keelbase</groupId>
  <artifactId>keelbase4j</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>KeelBase4J</name>
  <description>
    KeelBase4J — Java runtime for KeelBase. Phase-0 spike (feasibility probe):
    the protocol module reproduces the frozen AI Governance Protocol vectors; the runtime module
    is a minimal Spring Boot app whose AI operations run through the governance trust loop
    (Identity → Permission → Governance → Confirmation → Audit → Revoke); the generator module
    turns a business request into real, standalone Spring Boot source.
  </description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <!--
    The split is load-bearing, not cosmetic. Generated applications depend on `keelbase4j-protocol`
    as a library; while protocol, runtime and generator shared one artifact, that library silently
    carried Spring Security, and a generated app inheriting its auto-configuration locked down every
    endpoint (that is how the demos first went red). The dependency direction is one-way —
    runtime → protocol and generator → protocol, never back — so the runtime stays the thing under
    test and an adapter (a model provider, an IdP) can sit outside it without changing it.
  -->
  <modules>
    <module>keelbase4j-protocol</module>
    <module>keelbase4j-runtime</module>
    <module>keelbase4j-generator</module>
    <module>keelbase4j-springai</module>
  </modules>
</project>
