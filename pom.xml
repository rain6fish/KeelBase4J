<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>cn.com.keelbase</groupId>
  <artifactId>keelbase4j</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>KeelBase4J</name>
  <description>
    KeelBase4J — Java runtime for KeelBase. Phase-0 spike (feasibility probe):
    the protocol module reproduces the frozen AI Governance Protocol vectors; the runtime module
    is a minimal Spring Boot app whose AI operations run through the governance trust loop
    (Identity → Permission → Governance → Confirmation → Audit → Revoke); the generator module
    turns a business request into real, standalone Spring Boot source.
  </description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <!-- Central requires this metadata on every published artifact — name, description, url, licenses,
       developers and scm. The children inherit it from here, so only the coordinates beside the
       artifact stay per-module. Only the parent pom and keelbase4j-protocol are published; the other
       modules opt out in their own release profiles (see below). -->
  <url>https://github.com/rain6fish/KeelBase4J</url>
  <scm>
    <connection>scm:git:https://github.com/rain6fish/KeelBase4J.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/rain6fish/KeelBase4J.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/rain6fish/KeelBase4J</url>
  </scm>
  <developers>
    <developer>
      <id>rain6fish</id>
      <name>Rain6fish</name>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <spring-ai.version>2.0.1</spring-ai.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- One place decides the Spring AI version, so the adapter and whichever provider the demo
           binds cannot drift apart. -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    The split is load-bearing, not cosmetic. Generated applications depend on `keelbase4j-protocol`
    as a library; while protocol, runtime and generator shared one artifact, that library silently
    carried Spring Security, and a generated app inheriting its auto-configuration locked down every
    endpoint (that is how the demos first went red). The dependency direction is one-way —
    runtime → protocol and generator → protocol, never back — so the runtime stays the thing under
    test and an adapter (a model provider, an IdP) can sit outside it without changing it.
  -->
  <modules>
    <module>keelbase4j-protocol</module>
    <module>keelbase4j-runtime</module>
    <module>keelbase4j-generator</module>
    <module>keelbase4j-springai</module>
    <module>keelbase4j-demo</module>
  </modules>

  <profiles>
    <!--
      Release profile: what Maven Central needs on top of an ordinary build — sources, javadocs and a
      signature for every published file. The upload itself runs in CI on a `v*` tag
      (.github/workflows/release.yml), so no signing key is needed on a developer machine.

      Not activated by default. Activating it changes nothing about what a normal build produces.

      What actually publishes is the *reactor*, not a per-module flag: `central-publishing-maven-plugin`
      bundles every module the build contains, and `maven.deploy.skip` does not reach it — the first
      attempt at this shipped all six modules for exactly that reason. So the deploy restricts the
      reactor instead (`-pl keelbase4j-protocol -am`, in .github/workflows/release.yml), and a step
      there checks the restriction still yields exactly two modules: this parent pom and
      keelbase4j-protocol, the artifact a generated application resolves. The parent travels with it
      because a consumer cannot resolve a child pom whose parent is absent from the repository.

      ⚠ Running `mvn -Prelease deploy` by hand, without `-pl`, would publish everything. Publishing
      goes through the workflow; nothing here stops a manual run from doing the wrong thing.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.2</version>
            <configuration>
              <!-- No pinentry in CI: sign from -Dgpg.passphrase, in batch mode. -->
              <gpgArguments>
                <arg>--batch</arg>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution><id>sign-artifacts</id><phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- Central Portal (central.sonatype.com). The token comes from the `central` server in
               settings.xml, which the release workflow writes from repository secrets. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
